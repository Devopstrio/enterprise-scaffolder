# --- Backend ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/factory_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=supersecret

# --- Cloud Provider Credentials ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AWS_ACCESS_KEY_ID=

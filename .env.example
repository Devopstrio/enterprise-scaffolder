# --- Factory Configuration ---
PROJECT_NAME=enterprise-factory
ENVIRONMENT=dev
DB_PASSWORD=
LOCATION=eastus

# --- Feature Toggles ---
ENABLE_SSO=true
ENABLE_MULTI_TENANT=true
ENABLE_MULTI_REGION=true
ENABLE_BACKSTAGE=true
ENABLE_GITOPS=true
ENABLE_AI_RECOMMENDER=true
ENABLE_AUTO_REPO_CREATION=true
